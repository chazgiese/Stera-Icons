{
  "name": "stera-icons",
  "version": "8.11.0",
  "type": "module",
  "description": "A lightweight, tree-shakeable React icon library (ESM-only)",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json",
    "./base": {
      "types": "./dist/esm/base.d.ts",
      "import": "./dist/esm/base.js",
      "default": "./dist/esm/base.js"
    },
    "./types": {
      "types": "./dist/esm/types.d.ts",
      "import": "./dist/esm/types.js",
      "default": "./dist/esm/types.js"
    },
    "./utils": {
      "types": "./dist/esm/utils.d.ts",
      "import": "./dist/esm/utils.js",
      "default": "./dist/esm/utils.js"
    },
    "./dynamic": {
      "types": "./dist/esm/dynamic.d.ts",
      "import": "./dist/esm/dynamic.js",
      "default": "./dist/esm/dynamic.js"
    },
    "./dynamic-variants": {
      "types": "./dist/esm/dynamic-variants.d.ts",
      "import": "./dist/esm/dynamic-variants.js",
      "default": "./dist/esm/dynamic-variants.js"
    },
    "./dynamicIconImports": {
      "types": "./dist/esm/dynamicIconImports.d.ts",
      "import": "./dist/esm/dynamicIconImports.js",
      "default": "./dist/esm/dynamicIconImports.js"
    },
    "./icons/*": {
      "types": "./dist/esm/icons/*.d.ts",
      "import": "./dist/esm/icons/*.js",
      "default": "./dist/esm/icons/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "rm -f dist/*.cjs dist/*.mjs dist/*.d.ts dist/*.d.cts dist/esm/stera-icons.js dist/esm/stera-icons.d.ts && tsup && node scripts/build-icons.js icons-export.json && node scripts/generate-declarations.js",
    "build:icons": "node scripts/build-icons.js icons-export.json && node scripts/generate-declarations.js",
    "build:dev": "tsup --config tsup.config.dev.ts",
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' tsup --watch --config tsup.config.dev.ts",
    "test": "vitest",
    "analyze:bundle": "node scripts/analyze-bundle-size.js",
    "benchmark": "node scripts/benchmark-build.js icons-export.json",
    "lint": "eslint src/",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svgo": "^4.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "react",
    "icons",
    "svg",
    "typescript",
    "tree-shakeable"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hauntedjpeg/Stera-Icons.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
